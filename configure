#!/bin/sh

die() {
    echo "$0: Error: $*" >&2
    exit 1
}

prihelp() {
    host="[$(cc -dumpmachine)]"
    : ${host:=""}
    cat << EOF
Usage: $0 [options]
Options:
  --help                    Print this help mesage
  --host=target-triple      $host
  --cc=cc                   C compiler [cc]
  --ld=ld                   Linker [ld]
  --ar=ar                   archiver [ar]
  --prefix=PREFIX           Installation path [/usr/local]
  --sysroot=/path           System root
  --includedir="/a/b",...   System include dirs
EOF
}

sysroot=
prefix=/usr/local
host=
linker=
ar=

for arg ; do
	case "$arg" in
	--host=*) host=${arg#*=} ;;
    --sysroot=*) sysroot=${arg#*=} ;;
    --includedir=*) host_include_dirs=${arg#*=} ;;
	CC=*) CC=${arg#*=} ;;
	--cc=*) CC=${arg#*=} ;;
	--ld=*) linker=${arg#*=} ;;
	--ar=*) ar=${arg#*=} ;;
	CFLAGS=*) CFLAGS=${arg#*=} ;;
	--cflags=*) CFLAGS=${arg#*=} ;;
    --prefix=*) prefix=$(sh -c "echo ${arg#*=}") ;;
    --help) prihelp ; exit ;;
	*) die "$0: unknown option '$arg'"
	esac
done

if ! test -n "$host"; then
    : ${CC:=cc}
    host=$($CC -dumpmachine)
else
    # try target-triple-cc (cross compiling)
    if ! test -n "$CC"; then
        for sfx in cc gcc; do
            if command -v "$host"-$sfx >/dev/null; then
                CC="$host"-$sfx
                break
            fi
        done
    fi
    : ${CC:=cc}
    if ! test -n "$linker" && command -v "$host"-ld >/dev/null; then
        linker="$host"-ld
    fi
    if ! test -n "$ar" && command -v "$host"-ar >/dev/null; then
        ar="$host"-ar
    fi
    if ! test -n "$sysroot"; then
        sysroot=$($CC -print-sysroot 2>/dev/null)
    fi
fi

test -n "$host" || die "cannot determine host"

host_arch=
host_os=unknown
host_abi=none
host_predefs=

echo "host: $host"
case "$host" in
x86_64-*) host_arch=x86_64 ;;
amd64-*) host_arch=x86_64 ;;
aarch64-*) host_arch=aarch64 ;;
arm64-*) host_arch=aarch64 ;;
*) die "unsupported target '$host'"
esac

linkargs=

probelink() {
    $CC -### "$1" -xc /dev/null 2>&1 | grep -E 'collect2|/ld' | tail -1
}

link_with_cc=0

parselink() {
    cmd="$1"
    p_dynamic_linker=
    eval "set -- $cmd"
    case "$1" in
        *ld*) : ${linker:="$1"} ;;
    esac
    while [ $# -gt 0 ]; do
        arg=$1
        case "$arg" in
        -dynamic-linker) shift; p_dynamic_linker="$1" ;;
        -dynamic-linker=*) p_dynamic_linker="${arg#*=}" ;;
        --dynamic-linker=*) p_dynamic_linker="${arg#*=}" ;;
        esac
        shift
    done
}

echo "trying to probe $CC for the dynamic linker..."
probe_nopie=$(probelink -no-pie)
probe_pie=$(probelink -pie)
probe=${probe_pie:-$probe_nopie}
if test -n "$probe"; then
    echo "extracting linker args from {$probe}"...
    parselink "$probe"
    : ${DYNAMIC_LINKER:=$p_dynamic_linker}
else
    echo "...did not work, will try a fallback"
fi

case "$host" in
*-linux-*gnu*)
    host_os=linux
    host_abi=gnu
    if [ -z "$DYNAMIC_LINKER" ]; then
        case $host_arch in
        x86_64) DYNAMIC_LINKER=$sysroot/lib64/ld-linux-x86-64.so.2 ;;
        aarch64) DYNAMIC_LINKER=$sysroot/lib/ld-linux-aarch64.so.1
        esac
    fi
    ;;
*-linux-*musl*)
    host_os=linux
    host_abi=musl
    # musl cross compiler in glibc system (probably)
    if test -d "$sysroot/usr/lib/musl/lib"; then
        musl_libdir=$sysroot/usr/lib/musl/lib
    fi
    if [ -z "$DYNAMIC_LINKER" ]; then
        case $host_arch in
        x86_64) DYNAMIC_LINKER=$sysroot/lib/ld-musl-x86_64.so.1 ;;
        aarch64) DYNAMIC_LINKER=$sysroot/lib/ld-musl-aarch64.so.1 ;;
        esac
    fi
    ;;
*-openbsd*)
    host_os=openbsd
    if [ -z "$DYNAMIC_LINKER" ]; then
        DYNAMIC_LINKER=$sysroot/usr/libexec/ld.so
    fi
    host_predefs='
    "_ANSI_LIBRARY", /* works around __only_inline functions in libc headers */
    '
    ;;
*-freebsd*)
    host_os=freebsd
    if [ -z "$DYNAMIC_LINKER" ]; then
        DYNAMIC_LINKER=$sysroot/libexec/ld-elf.so.1
        DYNAMIC_LINKER=$sysroot/usr/libexec/ld.so
    fi
    host_predefs='
    "_USE_CTYPE_INLINE_", /* to get xlocal/_ctype.h to define _RuneLocale */
    '
    ;;
*-android*)
    host_os=android
    android_sdk_version=24 # works on my machine (TM)
    host_predefs='
    /* bionic uses many clang extensions */
    "_Nonnull=",
    "_Nullable=",
    "_Null_unspecified=",
    "__ANDROID_MIN_SDK_VERSION__='$android_sdk_version'",
    "__ANDROID_API__=__ANDROID_MIN_SDK_VERSION__",
    "BIONIC_IOCTL_NO_SIGNEDNESS_OVERLOAD",
    "__availability__(...)=",
    '
    # termux silly
    if test -n "$PREFIX" && test -d "$PREFIX/lib"; then
        android_libdir=$PREFIX/lib
    fi
    if [ -z "$DYNAMIC_LINKER" ]; then
        link_with_cc=1
    fi
    ;;
*)
    echo "warning: unknown/unsupported target '$host'" >&2
    if [ -z "$DYNAMIC_LINKER" ]; then
        link_with_cc=1
    fi
esac

# -L dirs for -lc and -l:crt*.o
findlibdir() {
    p=$($CC -print-file-name="$1" 2>/dev/null)
    case "$p" in
    /*) d=$(dirname "$p") && realpath "$d" ;;
    esac
}
linkargs=
seen='|'
addlibdir() {
    test -n "$1" || return
    case "$seen" in *"|$1|"*) return ;; esac
    seen="$seen$1|"
    linkargs="$linkargs \"-L\", \"$1\","
}
if [ -n "$musl_libdir" ]; then
    addlibdir "$musl_libdir"
else
    crtdir=
    for f in crt1.o crtbegin_dynamic.o crtbegin_so.o crt0.o; do
        crtdir=$(findlibdir "$f")
        test -n "$crtdir" && break
    done
    addlibdir "$android_libdir"
    addlibdir "$crtdir"
    addlibdir "$(findlibdir libc.so)"
    addlibdir "$sysroot/usr/local/lib"
    addlibdir "$sysroot/usr/lib"
    addlibdir "$sysroot/lib"
fi

: ${linker:=ld}
echo using linker: "$linker"
if test -n "$DYNAMIC_LINKER"; then
    DYNAMIC_LINKER=\"$DYNAMIC_LINKER\"
fi
echo dynamic linker: $DYNAMIC_LINKER

: ${ar:=ar}
echo using ar: "$ar"

# realpath(1) is apparently not portable
realpath() {
    (cd -P "$1" 2>/dev/null && pwd -P)
}

tryincldir() {
    if stat "$1"/ >/dev/null 2>/dev/null; then
        host_include_dirs="$host_include_dirs\"$1\","
    fi
}

if ! test -n "$host_include_dirs"; then
    # try to query host toolchain first
    if hostccdirs=$($CC -E -v -xc /dev/null 2>&1 | sed -n '/#include <...> search starts here:/,/End of search list./{
    s/^[[:space:]]*//
    /^\/.*/p
}') && test -n "$hostccdirs"; then
        echo "using $CC's system include paths:"
        for d in $hostccdirs; do
            dir=$(realpath "$d")
            case "$dir" in
                #exclude internal compiler headers, we have our own
                */gcc/*) ;; */clang/*) ;;
                *) echo "    $dir"
                   tryincldir "$dir" ;;
            esac
        done
    else
        echo "Falling back to generic system include paths"
        tryincldir "$sysroot/usr/local/include/$host"
        tryincldir "$sysroot/usr/local/include"
        tryincldir "$sysroot/usr/include/$host"
        tryincldir "$sysroot/usr/include"
    fi
fi

set -e

echo using arch: "$host_arch"
echo using os: "$host_os"
echo using abi: "$host_abi"
echo host include paths: {"$host_include_dirs"}
echo preprocessor predefs: {"$host_predefs"}

# bump whenever ./configure is updated in an incompatible way so compilation can check it
configure_ver=261019

echo "/** GENERATED WITH $0 $* **/
#define CONFIGURE_VER $configure_ver
#define HOST_TRIPLE \"$host\"
#define HOST_ARCH   IS$host_arch
#define HOST_OS     OS$host_os
#define HOST_ABI    ABI$host_abi
static const char *const host_incldirs[] ={$host_include_dirs 0};
static const char *const host_predefs[] = {$host_predefs 0};
#define HOST_LD \"$linker\"
#define HOST_AR \"$ar\"
#define HOST_CC \"$CC\"
#define HOST_LINK_WITH_CC $link_with_cc
#define HOST_DYNAMIC_LINKER ${DYNAMIC_LINKER:=NULL}
static const char *const host_linkargs[] = {${linkargs:=0}};" \
  | tee src/hostconfig.h | tail -n 6 | sed -E 's/#define|static const char .const/ +/'

echo "# GENERATED WITH $0 $*
PREFIX = $prefix
CC     = $CC
CFLAGS = ${CFLAGS:--Wall -std=c11 -pedantic}" > config.mk

echo config written to src/hostconfig.h, config.mk
