source [file dirname $argv0]/common.tcl

proc findtripcount {out} {
   set trips {}
   foreach {m x} [regexp -all -inline {trips=([^[:space:]]+)} $out] {
      lappend trips $x
   }
   return $trips
}

set prog { typedef unsigned long long u64int; typedef long long s64int;
   volatile int sink;
#define SINK sink,sink,sink,sink,sink,sink,sink
#define NOINVERT (SINK,SINK)

   s64int oadd(void) {
      s64int s = 0;
      for (int i = 0; i < 10; ++i)
         s += i + 5;
      return s;
   }

   s64int shl3(void) {
      s64int s = 0;
      for (int i = 0; i < 10; ++i)
         s += i << 3;
      return s;
   }

   s64int muloff(void) {
      s64int s = 0;
      for (int i = 0; i < 10; ++i)
         s += i * 3 + 1;
      return s;
   }

   s64int mulneg(void) {
      s64int s = 0;
      for (int i = 0; i < 10; ++i)
         s += i * -3;
      return s;
   }

   s64int down2(void) {
      s64int s = 0;
      for (int i = 20; i > 0; i -= 2)
         s += i;
      return s;
   }

   s64int noinvert(int n) {
      s64int s = 0;
      for (int i = 0; NOINVERT, i < 10; ++i)
         s += i + n;
      return s;
   }
}

set out [c+out {-O1 -dloop -dfilter=oadd} $prog]
asserteq "offset init" [regexp -all {phi @[0-9]+ 5,} $out] 1
asserteq "offset trips" [findtripcount $out] 10
set out [c+out {-O1 -dloop -dfilter=shl3} $prog]
asserteq "shl stride" [regexp -all {= add %[0-9]+, 8\M} $out] 1
asserteq "shl trips" [findtripcount $out] 10
set out [c+out {-O1 -dloop -dfilter=muloff} $prog]
asserteq "mul+offset init" [regexp -all {phi @[0-9]+ 1,} $out] 1
asserteq "mul+offset stride" [regexp -all {= add %[0-9]+, 3\M} $out] 1
asserteq "mul+offset trips" [findtripcount $out] 10
set out [c+out {-O1 -dloop -dfilter=mulneg} $prog]
asserteq "negative scale stride" [regexp -all {= add %[0-9]+, -3\M} $out] 1
asserteq "negative scale trips" [findtripcount $out] 10
set out [c+out {-O1 -dloop -dfilter=down2} $prog]
asserteq "descending stride 2" [regexp -all {= add %[0-9]+, -2\M} $out] 1
asserteq "descending stride 2 trips" [findtripcount $out] 10
set out [c+out {-O1 -dloop -dfilter=noinvert} $prog]
asserteq "noinvert 10 trips" [findtripcount $out] 10
asserteq "noinvert limit check became neq" [regexp -all {= neq\M} $out] 1

# loop iv correctness, overflow, widen soundness
set prog { typedef unsigned long long u64int; typedef long long s64int;

   u64int wrap(void) {
      u64int s = 0;
      unsigned i = 0xFFFFFFF0u;
      do {
         s += (u64int)i;
         i += 16u;
      } while (i < 0x10u);
      return s;
   }

   u64int uw(void) {
      u64int s = 0;
      for (unsigned i = 0; i < 10; ++i)
         s += (u64int)i;
      return s;
   }

   s64int wred(void) {
      s64int s = 0;
      for (int i = 0; i < 10; ++i)
         s += i;
      return s;
   }

   s64int wreddown(void) {
      s64int s = 0;
      for (int i = 10; i > 0; --i)
         s += i;
      return s;
   }

   s64int uwrap(void) {
      s64int s = 0;
      for (int i = -5; i < 5; ++i)
         s += (unsigned)i;
      return s;
   }

   s64int wscale(void) {
      s64int s = 0;
      for (int i = 2; i < 10; i += 2)
         s += i * 3;
      return s;
   }

   s64int parr(int *p, int n) {
      s64int s = 0;
      for (int i = 0; i < n; ++i)
         s += p[i];
      return s;
   }

   s64int biginit(void) {
      s64int s = 0;
      for (int i = 1<<30; i < (1<<30)+100; ++i)
         s += i;
      return s;
   }

   s64int wcnt(void) {
      s64int s = 0;
      for (unsigned i = 101; (long)(int)(i * 1024u) < 200000; i += 2097051u) {
         s += i;
         if (i > 2000000000u) return s;
      }
      return s;
   }
}
set out [c+out {-O1 -dafter=loopopt -dfilter=wrap} $prog]
asserteq "wrapping widen kept" [regexp -all {\mextu32\M} $out] 1
set out [c+out {-O1 -dloop -dfilter=uw} $prog]
asserteq "unsigned constant widen reduced" [regexp -all {= extu32\M} $out] 0
asserteq "unsigned constant trips" [findtripcount $out] 10
set out [c+out {-O1 -dloop -dfilter=uwrap} $prog]
asserteq "extu32 crossing zero kept" [regexp -all {= extu32\M} $out] 1
asserteq "crossing zero trips" [findtripcount $out] 10

set out [c+out {-O1 -dloop -dfilter=wred} $prog]
asserteq "ascending widen reduced" [regexp -all {= exts32\M} $out] 0
asserteq "ascending trips" [findtripcount $out] 10
set out [c+out {-O1 -dloop -dfilter=wreddown} $prog]
asserteq "descending widen reduced" [regexp -all {= exts32\M} $out] 0
asserteq "descending trips" [findtripcount $out] 10

set out [c+out {-O1 -dloop -dfilter=wscale} $prog]
asserteq "scaled init" [regexp -all {phi @[0-9]+ 6,} $out] 1
asserteq "scaled stride" [regexp -all {= add %[0-9]+, 6\M} $out] 1
asserteq "scaled trips" [findtripcount $out] 4

set out [c+out {-O1 -dafter=loopopt -dfilter=biginit} $prog]
asserteq "bound guard keeps widen" [regexp -all {\mexts32\M} $out] 1

set out [c+out {-O1 -dafter=loopopt -dfilter=wcnt} $prog]
asserteq "widen counter kept" [regexp -all {= exts32\M} $out] 1

set out [c+out {-O1 -dafter=loopopt -dfilter=parr} $prog]
asserteq "pointer increments by elemsize" [regexp -all {ptr %[0-9]+ = add %[0-9]+, 4} $out] 1
asserteq "limit check became neq ptr" [regexp -all {= neq ptr\M} $out] 1

# runtime trip counts, stepped counters, overshoot, and wrap/no-transform cases
set prog { typedef unsigned long long u64int; typedef long long s64int;
   volatile int sink;
#define SINK sink,sink,sink,sink,sink,sink,sink
#define NOINVERT (SINK,SINK)

   s64int step3(s64int n, int *p) {
      s64int s = 0;
      for (s64int i = 0; i < n; i += 3)
         s += p[i];
      return s;
   }

   s64int downstep(s64int n, int *p) {
      s64int s = 0;
      for (s64int i = n; i > 0; i -= 3)
         s += p[i-1];
      return s;
   }

   s64int ovs(int *p) {
      s64int s = 0;
      for (s64int i = 0; i < 5; i += 3)
         s += p[i];
      return s;
   }

   s64int scaledcond(void) {
      s64int s = 0;
      for (s64int i = 0; 4*i < 9; ++i)
         s += i;
      return s;
   }

   s64int ushift(void) {
      unsigned s = 0;
      for (unsigned i = 0; i < 5000; ++i)
         s += i << 20;
      return s;
   }

   u64int uwrun(unsigned n) {
      u64int s = 0;
      for (unsigned i = 0; i < n; ++i)
         s += (u64int)i;
      return s;
   }

   u64int uwrunp(unsigned long n, int *p) {
      u64int s = 0;
      for (unsigned long i = 0; i < n; ++i)
         s += p[i];
      return s;
   }

   u64int uwrunni(unsigned long n, int *p) {
      u64int s = 0;
      for (unsigned long i = 0; NOINVERT, i < n; ++i)
         s += p[i];
      return s;
   }
}
set out [c+out {-O1 -dloop -dfilter=step3} $prog]
asserteq "is counted loop" [regexp -all {got counted loop} $out] 1
asserteq "limit check became neq ptr" [regexp -all {= neq ptr\M} $out] 1
set out [c+out {-O1 -dloop -dfilter=downstep} $prog]
asserteq "is counted loop" [regexp -all {got counted loop} $out] 1
asserteq "limit check became neq ptr" [regexp -all {= neq ptr\M} $out] 1
set out [c+out {-O1 -dloop -dfilter=ovs} $prog]
asserteq "constant trips with overshot counter" [findtripcount $out] 2
asserteq "limit check bedcame neq ptr" [regexp -all {= neq ptr\M} $out] 1
set out [c+out {-O1 -dloop -dfilter=scaledcond} $prog]
asserteq "scaled counter iv not counted" [findtripcount $out] {}
asserteq "no ivs materialized" [regexp -all {materialize iv:} $out] 0
set out [c+out {-O1 -dloop -dfilter=ushift} $prog]
asserteq "wrapping unsigned shift no limit check rewrite" [regexp -all {replaced original limit check} $out] 0
set out [c+out {-O1 -dloop -dfilter=uwrun} $prog]
asserteq "runtime unsigned counted" [regexp -all {got counted loop} $out] 1
set out [c+out {-O1 -dloop -dfilter=uwrunp} $prog]
asserteq "runtime unsigned pointer counted" [regexp -all {got counted loop} $out] 1
asserteq "runtime unsigned pointer neq" [regexp -all {= neq ptr\M} $out] 1
set out [c+out {-O1 -dloop -dfilter=uwrunni} $prog]
asserteq "non-inverted runtime unsigned counted" [regexp -all {got counted loop} $out] 1
asserteq "non-inverted runtime unsigned pointer neq" [regexp -all {= neq ptr\M} $out] 1

# non-counted loops with induction variables
set prog { struct node { struct node *next; int value; };

   void ncsum(struct node *list, int *p) {
      int n = 0;
      for (; list; list = list->next)
         p[n++] = list->value;
   }

   int ncsumret(struct node *list, int *p) {
      int n = 0;
      for (; list; list = list->next)
         p[n++] = list->value;
      return n;
   }
}
set out [c+out {-O1 -dloop -dfilter=ncsum} $prog]
asserteq "loop not counted" [regexp -all {got counted loop} $out] 0
asserteq "pointer iv update" [regexp -all {= add %[0-9]+, 4\M} $out] 1
asserteq "index extend gone" [regexp -all {= exts32\M} $out] 0
asserteq "index shift gone" [regexp -all {= shl\M} $out] 0
set out [c+out {-O1 -dloop -dfilter=ncsumret} $prog]
asserteq "loop not counted" [regexp -all {got counted loop} $out] 0
asserteq "not materialized" [regexp -all {materialize iv:} $out] 0
asserteq "widen kept" [regexp -all {= exts32\M} $out] 1
asserteq "shift kept" [regexp -all {= shl\M} $out] 1

# vim:set ts=3 sw=3 expandtab:
