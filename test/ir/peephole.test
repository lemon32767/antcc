source [file dirname $argv0]/common.tcl

set prog { int addzero(int t) { return t+0; } }
set nadd [regexp -all "= add " [c+out -dparse $prog]]
asserteq "add zero" $nadd 0

set prog { int mulzero(int t) { return t*(1-1); } }
set retrn [regexp -line -inline {\mret\M.*$} [c+out -dparse $prog]]
asserteq "return mul by zero" $retrn [list "ret 0"]

set prog { int mul4(int t) { return t*4; } }
set arith [regexp -inline -all {= \m\w{3}\M} [c+out -dparse $prog]]
asserteq "mul -> shl" $arith [list "= shl"]

set prog {int div1(int t) { return t/1; }}
set ndiv [regexp -all {\mdiv\M} [c+out "-dafter=optimize -O2" $prog]]
asserteq "div/1 -> nop" $ndiv 0
